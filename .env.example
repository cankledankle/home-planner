# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/homeplanner?sslmode=disable

# Application
PORT=8080
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your-jwt-secret-change-in-production

# R2 Storage (Cloudflare)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name

# SFTPGo Admin API
SFTPGO_API_URL=http://localhost:8081
SFTPGO_ADMIN_USERNAME=admin
SFTPGO_ADMIN_PASSWORD=admin
SFTPGO_HOST=localhost

# Admin Seed (optional - creates admin user on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin User
