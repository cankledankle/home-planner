# Home Planner Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_DB=homeplanner
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgres://postgres:your_secure_password_here@postgres:5432/homeplanner?sslmode=disable

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Required: Your domain (e.g., https://homeplanner.example.com)
FRONTEND_URL=https://your-domain.com

# Required: JWT secret for authentication (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_here

# ============================================
# ADMIN USER (auto-created on first run)
# ============================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password_here
ADMIN_NAME=Administrator

# ============================================
# SFTPGo FILE SERVER
# ============================================
SFTPGO_ADMIN_USERNAME=admin
SFTPGO_ADMIN_PASSWORD=your_sftpgo_password_here

# ============================================
# R2 CLOUD STORAGE (Optional)
# ============================================
# Leave empty if not using R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ============================================
# DOKPLOY SPECIFIC (for docker-compose.dokploy.yml)
# ============================================
# GitHub Container Registry image to use
APP_IMAGE=ghcr.io/yourusername/home-planner:latest

# ============================================
# PRODUCTION NGINX (for docker-compose.prod.yml)
# ============================================
DOMAIN=your-domain.com

# ============================================
# BUILD CONFIGURATION
# ============================================
# GitHub username for image tagging
GITHUB_REPOSITORY_OWNER=yourusername
