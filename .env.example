# Environment Variables
# 
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Required for all environments (production, staging, development)

# Database
DB_NAME=homeplanner
POSTGRES_PASSWORD=your_secure_password_here

# Database Connection Pool (optional - defaults shown)
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME=30m
# DB_CONN_MAX_IDLE_TIME=10m

# Application
IMAGE_TAG=latest
FRONTEND_URL=https://yourdomain.com

# Domain (used by Caddy for automatic HTTPS)
DOMAIN=yourdomain.com

# JWT Secrets (generate strong random strings)
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# Admin User (only used on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=secure_admin_password
ADMIN_NAME=Admin

# Optional: Cloudflare R2 for file storage
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=your_bucket

# Optional: Backup Configuration
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=30
# BACKUP_NOTIFICATION_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL