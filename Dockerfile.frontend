# Frontend build stage - creates static files
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./
RUN npm ci

# Copy source code
COPY . .

# Build static files
RUN npm run build

# Production stage - serves static files via Go backend
# This is just for building; the actual serving is done by Go
FROM alpine:latest AS static-files

WORKDIR /app

# Copy built static files
COPY --from=builder /app/build ./build

# This stage is used to extract the build artifacts
# The Go server will serve these files